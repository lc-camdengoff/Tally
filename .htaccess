# Tally — /filmmaking/tally/
#
# The app is index.html. api.php is the only page that runs; sign-in is the
# shared one in /filmmaking/auth/.

DirectoryIndex index.html

Options -Indexes

# lib.php and schema.sql are includes, never pages.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^lib\.php$ - [F,L]
  RewriteRule ^schema\.sql$ - [F,L]
  RewriteRule (^|/)\. - [F,L]
</IfModule>

# Belt to that braces, in case mod_rewrite is unavailable.
<FilesMatch "^(lib\.php|schema\.sql)$|^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  # The service worker has to be fetched fresh, or a deploy can take a day to
  # reach a phone.
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
